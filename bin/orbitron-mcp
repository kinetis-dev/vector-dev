#!/bin/sh
# Launches the Orbitron stdio MCP server in a disposable container
# derived from this project's `app` service, and relays it to whatever
# started this script, so an MCP-capable client on the host reaches the
# server without PHP or Composer existing on the host. Configured in
# .mcp.json, .codex/config.toml and .gemini/settings.json.
#
# The Compose project lives in demo/ and the Kinetis application — the
# Orbitron project — in demo/backend; both are derived from this
# script's own location, so the checked-in configuration works in any
# clone, at any path, from any client working directory. The Compose
# file fixes the project name, which selects the image and the vendor
# volume this server shares with `app`.
#
# The server sees the repository as /workspace and works in
# /workspace/demo/backend, the `app` service's own working directory.
# The physical host path of that directory is handed to it separately,
# as KINETIS_ORBITRON_CHECKOUT_ROOT, and `orbitron_inspect` reports it
# back as `checkoutRoot` for the agent to compare with `pwd -P` in
# demo/backend. The server never reads through that path.
#
# `run` starts a one-off container that shares the `app` service's image
# and mounts, but not its process lifecycle: restarting, recreating or
# rebuilding `app` does not disconnect an established session. Docker
# itself stopping, and this script's own process ending, always do.
#
# A complete `docker compose down` is outside that guarantee either way:
# on Compose v5.5.1, a live one-off still holds the project network,
# so `down` can remove `app`, leave this session alive, and still exit
# nonzero over that network being in use. End this session
# before running a complete `down`.
#
# --rm removes the one-off container when this script's process ends.
# --no-deps starts only this one container, not the rest of the stack.
# --entrypoint sh bypasses the demo entrypoint, whose unconditional
# `composer install` would run on every launch. This container installs
# only when the shared vendor volume has never been populated — a fresh
# clone — under the same `vendor/.install.lock` the entrypoint takes, so
# it never writes the tree while the `app` container's own install does.
# Composer's output goes to stderr, and --progress quiet keeps
# Compose's own, including an image build's, off stdout: stdout carries
# only the protocol.
# -T is required, not cosmetic: an allocated TTY would rewrite the
# newline-delimited JSON-RPC frames the protocol depends on.
#
# A fresh clone therefore needs no setup before its first launch: a
# missing backend/.env is copied from backend/.env.example, which is
# what the README's own first step does, and Compose builds the image
# when it is absent. That first launch is as slow as the build and the
# install, and a client whose server start-up timeout is shorter reports
# the server as failed; `docker compose up --build -d` beforehand avoids
# that.
set -e

project_directory=$(CDPATH='' cd -- "$(dirname -- "$0")/../demo" && pwd)
checkout_root=$(CDPATH='' cd -- "$project_directory/backend" && pwd -P)

if [ ! -e "$checkout_root/.env" ]; then
    cp "$checkout_root/.env.example" "$checkout_root/.env"
fi

exec docker compose --progress quiet --project-directory "$project_directory" \
    run --rm -T --no-deps --entrypoint sh \
    -e KINETIS_ORBITRON_CHECKOUT_ROOT="$checkout_root" app -c '
        set -e
        if [ ! -e vendor/autoload.php ]; then
            mkdir -p vendor
            flock vendor/.install.lock \
                composer install --no-interaction --no-progress >&2
        fi
        exec php vendor/bin/kinetis-orbitron-mcp
    '
