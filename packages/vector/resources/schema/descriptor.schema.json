{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://kinetis.dev/schemas/vector/descriptor.json",
    "title": "Vector descriptor",
    "description": "What GET /vector/schema publishes: the compiled resources, settings groups, dashboards, menu and branding, overlaid with the caller's permissions and translated into the caller's language.",
    "type": "object",
    "required": [
        "version",
        "resources",
        "menu",
        "settings",
        "dashboards",
        "capabilities"
    ],
    "properties": {
        "version": {
            "type": "integer",
            "const": 4
        },
        "resources": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/resource"
            }
        },
        "menu": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "label",
                    "resources"
                ],
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "resources": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "settings": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/named"
            }
        },
        "dashboards": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/named"
            }
        },
        "capabilities": {
            "type": "object",
            "required": [
                "impersonation",
                "queue"
            ],
            "properties": {
                "impersonation": {
                    "type": "boolean"
                },
                "queue": {
                    "type": "boolean"
                },
                "uploads": {
                    "type": "boolean"
                },
                "exportFormats": {
                    "description": "The export formats offered: csv always; xlsx where openspout/openspout and ext-zip are installed, VECTOR_EXPORT_FORMATS lists it, and a queue runs it.",
                    "type": "array",
                    "items": {
                        "enum": [
                            "csv",
                            "xlsx"
                        ]
                    },
                    "uniqueItems": true
                }
            }
        },
        "i18n": {
            "description": "The language this descriptor's labels are in, and the languages this user may switch to: the ones the administrator enabled in the Languages settings group.",
            "type": "object",
            "required": [
                "locale",
                "locales"
            ],
            "properties": {
                "locale": {
                    "type": "string"
                },
                "locales": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "code",
                            "name",
                            "dir"
                        ],
                        "properties": {
                            "code": {
                                "type": "string"
                            },
                            "name": {
                                "description": "The language's name in itself.",
                                "type": "string"
                            },
                            "dir": {
                                "enum": [
                                    "ltr",
                                    "rtl"
                                ]
                            }
                        }
                    }
                }
            }
        },
        "branding": {
            "type": [
                "object",
                "null"
            ]
        },
        "minorUnits": {
            "description": "The ISO 4217 minor-unit exponent of every currency whose minor unit is not a hundredth; a money value is in its currency's minor units.",
            "type": "object",
            "additionalProperties": {
                "type": "integer",
                "minimum": 0
            }
        }
    },
    "$defs": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "named": {
            "type": "object",
            "required": [
                "name",
                "label"
            ],
            "properties": {
                "name": {
                    "$ref": "#/$defs/slug"
                },
                "label": {
                    "type": "string"
                },
                "icon": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "sort": {
            "type": "object",
            "required": [
                "field",
                "order"
            ],
            "properties": {
                "field": {
                    "type": "string"
                },
                "order": {
                    "enum": [
                        "asc",
                        "desc"
                    ]
                }
            }
        },
        "rule": {
            "type": "object",
            "required": [
                "constraint",
                "args"
            ],
            "properties": {
                "constraint": {
                    "type": "string"
                },
                "args": {
                    "type": "array"
                }
            }
        },
        "field": {
            "type": "object",
            "required": [
                "name",
                "type",
                "label",
                "sortable",
                "searchable",
                "filterable",
                "readonly",
                "views",
                "rules",
                "operators",
                "summary",
                "hasDefault"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "enum": [
                        "id",
                        "string",
                        "text",
                        "markdown",
                        "number",
                        "money",
                        "boolean",
                        "enum",
                        "date",
                        "datetime",
                        "email",
                        "url",
                        "password",
                        "slug",
                        "color",
                        "json",
                        "keyValue",
                        "currency",
                        "file",
                        "image",
                        "belongsTo",
                        "hasOne",
                        "hasMany",
                        "manyToMany",
                        "computed",
                        "richtext"
                    ]
                },
                "label": {
                    "type": "string"
                },
                "sortable": {
                    "type": "boolean"
                },
                "searchable": {
                    "type": "boolean"
                },
                "filterable": {
                    "type": "boolean"
                },
                "readonly": {
                    "type": "boolean"
                },
                "repeater": {
                    "description": "An owned hasMany edited in the parent's form: the child fields a row writes, and how many rows it holds. Sent as a list of rows; a row with an `id` updates that child, one without creates it, and a child left out is deleted.",
                    "type": [
                        "object",
                        "null"
                    ],
                    "required": [
                        "fields",
                        "min",
                        "max"
                    ],
                    "properties": {
                        "fields": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "min": {
                            "type": "integer"
                        },
                        "max": {
                            "type": "integer"
                        }
                    },
                    "additionalProperties": false
                },
                "inline": {
                    "type": "boolean",
                    "description": "Editable in the list's cell (inlineEditable()), saved through POST …/changes."
                },
                "help": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "component": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "views": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "index",
                            "show",
                            "create",
                            "update"
                        ]
                    }
                },
                "rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/rule"
                    }
                },
                "props": {
                    "type": [
                        "object",
                        "array"
                    ]
                },
                "summary": {
                    "enum": [
                        "sum",
                        "avg",
                        "min",
                        "max",
                        "count",
                        null
                    ]
                },
                "hasDefault": {
                    "type": "boolean"
                },
                "operators": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "eq",
                            "ne",
                            "lt",
                            "lte",
                            "gt",
                            "gte",
                            "in",
                            "nin",
                            "like",
                            "nlike",
                            "between",
                            "null",
                            "nnull"
                        ]
                    }
                },
                "nullable": {
                    "type": "boolean"
                },
                "valueType": {
                    "enum": [
                        "string",
                        "int",
                        "float",
                        "bool",
                        "timestamp",
                        "date"
                    ]
                },
                "options": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "value",
                            "label"
                        ],
                        "properties": {
                            "value": {
                                "type": [
                                    "string",
                                    "integer"
                                ]
                            },
                            "label": {
                                "type": "string"
                            },
                            "color": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        }
                    }
                },
                "relation": {
                    "type": "object",
                    "required": [
                        "kind",
                        "resource"
                    ],
                    "properties": {
                        "kind": {
                            "enum": [
                                "belongsTo",
                                "hasOne",
                                "hasMany",
                                "manyToMany"
                            ]
                        },
                        "resource": {
                            "$ref": "#/$defs/slug"
                        },
                        "titleField": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "inverse": {
                            "type": "string"
                        },
                        "dependsOn": {
                            "description": "A dependent choice list: the options are the target records whose `on` equals this form's `field`.",
                            "type": [
                                "object",
                                "null"
                            ],
                            "required": [
                                "field",
                                "on",
                                "label"
                            ],
                            "properties": {
                                "field": {
                                    "type": "string"
                                },
                                "on": {
                                    "type": "string"
                                },
                                "label": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "conditions": {
                    "type": "object",
                    "required": [
                        "visible",
                        "required",
                        "disabled"
                    ],
                    "properties": {
                        "visible": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/condition"
                            }
                        },
                        "required": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/condition"
                            }
                        },
                        "disabled": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/condition"
                            }
                        }
                    }
                },
                "computed": {
                    "description": "A computed field's display kind and the fields its value is computed from. Read-only; never sorted, filtered, searched or written.",
                    "type": "object",
                    "required": [
                        "as",
                        "from"
                    ],
                    "properties": {
                        "as": {
                            "enum": [
                                "text",
                                "number",
                                "money",
                                "boolean",
                                "date",
                                "datetime",
                                "enum"
                            ]
                        },
                        "from": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "additionalProperties": false
                },
                "richtext": {
                    "description": "A rich-text field: the editor's JSON document, validated against this schema on write. `features` is the allow-list of node and mark types; images come from `imageField`'s uploads and are stored as storage keys; mentions from the `mentions` relation. `storesHtml` means the stored value (as read) is HTML rendered through the same schema.",
                    "type": "object",
                    "required": [
                        "features",
                        "imageField",
                        "mentions",
                        "storesHtml",
                        "maxBytes"
                    ],
                    "properties": {
                        "features": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "imageField": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "mentions": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "storesHtml": {
                            "type": "boolean"
                        },
                        "maxBytes": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    "additionalProperties": false
                },
                "markdown": {
                    "description": "A Markdown field's editor toolbar. The stored value is Markdown source.",
                    "type": "object",
                    "required": [
                        "toolbar"
                    ],
                    "properties": {
                        "toolbar": {
                            "type": "array",
                            "items": {
                                "enum": [
                                    "bold",
                                    "italic",
                                    "strike",
                                    "code",
                                    "heading",
                                    "list",
                                    "blockquote",
                                    "codeBlock",
                                    "horizontalRule",
                                    "link"
                                ]
                            }
                        }
                    },
                    "additionalProperties": false
                },
                "unique": {
                    "description": "The value is unique among the resource's records (unique()): a duplicated record's form starts without it, and a CSV import may match rows by it.",
                    "type": "boolean"
                },
                "default": {
                    "description": "The value a create form starts with (hasDefault says whether there is one); for a Currency field without its own, VECTOR_CURRENCY."
                }
            },
            "not": {
                "anyOf": [
                    {
                        "required": [
                            "column"
                        ]
                    },
                    {
                        "required": [
                            "enum"
                        ]
                    }
                ]
            }
        },
        "action": {
            "type": "object",
            "required": [
                "name",
                "label",
                "destructive",
                "standalone",
                "queued",
                "showOnIndex",
                "showOnDetail",
                "fields"
            ],
            "properties": {
                "name": {
                    "$ref": "#/$defs/slug"
                },
                "label": {
                    "type": "string"
                },
                "icon": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "confirmation": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "destructive": {
                    "type": "boolean"
                },
                "standalone": {
                    "type": "boolean"
                },
                "queued": {
                    "type": "boolean"
                },
                "chunkSize": {
                    "type": "integer",
                    "minimum": 1
                },
                "showOnIndex": {
                    "type": "boolean"
                },
                "showOnDetail": {
                    "type": "boolean"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/field"
                    }
                }
            },
            "not": {
                "required": [
                    "class"
                ]
            }
        },
        "widget": {
            "type": "object",
            "required": [
                "name",
                "label",
                "type",
                "ranges",
                "width",
                "cacheSeconds"
            ],
            "properties": {
                "name": {
                    "$ref": "#/$defs/slug"
                },
                "label": {
                    "type": "string"
                },
                "type": {
                    "enum": [
                        "stat",
                        "trend",
                        "partition",
                        "progress",
                        "table"
                    ]
                },
                "icon": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "ranges": {
                    "type": [
                        "object",
                        "array"
                    ]
                },
                "width": {
                    "enum": [
                        3,
                        4,
                        6,
                        12
                    ]
                },
                "cacheSeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "cacheShared": {
                    "description": "Whether the widget's cached result is shared by every user (true) or kept per user.",
                    "type": "boolean"
                }
            },
            "not": {
                "required": [
                    "class"
                ]
            }
        },
        "resource": {
            "type": "object",
            "required": [
                "slug",
                "label",
                "labelSingular",
                "primaryKey",
                "titleField",
                "fields",
                "table",
                "show",
                "creation",
                "softDelete",
                "actions",
                "widgets",
                "permissions",
                "layout"
            ],
            "properties": {
                "slug": {
                    "$ref": "#/$defs/slug"
                },
                "label": {
                    "type": "string"
                },
                "labelSingular": {
                    "type": "string"
                },
                "group": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "icon": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "primaryKey": {
                    "type": "object",
                    "required": [
                        "field",
                        "type"
                    ],
                    "properties": {
                        "field": {
                            "type": "string"
                        },
                        "type": {
                            "enum": [
                                "int",
                                "string"
                            ]
                        }
                    }
                },
                "titleField": {
                    "type": "string"
                },
                "version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/field"
                    }
                },
                "table": {
                    "type": "object",
                    "required": [
                        "columns",
                        "defaultSort",
                        "perPage",
                        "perPageOptions",
                        "maxPerPage",
                        "search",
                        "groupable",
                        "summaries",
                        "exportLimit",
                        "bulkLimit"
                    ],
                    "properties": {
                        "columns": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "extra": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "defaultSort": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/sort"
                            },
                            "minItems": 1
                        },
                        "perPage": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "perPageOptions": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        },
                        "maxPerPage": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "search": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "groupable": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "summaries": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "exportLimit": {
                            "type": "integer"
                        },
                        "exportQueueLimit": {
                            "type": "integer"
                        },
                        "bulkLimit": {
                            "type": "integer"
                        }
                    }
                },
                "show": {
                    "type": "object",
                    "required": [
                        "fields"
                    ],
                    "properties": {
                        "fields": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "creation": {
                    "type": "object",
                    "required": [
                        "possible"
                    ],
                    "properties": {
                        "possible": {
                            "type": "boolean"
                        },
                        "reason": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "softDelete": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "properties": {
                        "field": {
                            "type": "string"
                        }
                    }
                },
                "badge": {
                    "description": "The count the menu shows beside the resource: its filter in the list grammar, a colour and what it counts.",
                    "type": [
                        "object",
                        "null"
                    ],
                    "required": [
                        "filter",
                        "color",
                        "label"
                    ],
                    "properties": {
                        "filter": {
                            "type": "object"
                        },
                        "color": {
                            "type": "string"
                        },
                        "label": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "searchResult": {
                    "description": "The fields a global search result shows besides its title.",
                    "type": "object",
                    "required": [
                        "subtitle",
                        "image"
                    ],
                    "properties": {
                        "subtitle": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "image": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "actions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/action"
                    }
                },
                "widgets": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/widget"
                    }
                },
                "permissions": {
                    "type": "object",
                    "required": [
                        "viewAny",
                        "create",
                        "update",
                        "delete",
                        "export",
                        "setDefaultView"
                    ]
                },
                "layout": {
                    "description": "How the form and the show page group the fields: sections, tabs and column spans, per view. Null when the resource declared none. Layout never changes what is validated, serialized or written.",
                    "type": [
                        "object",
                        "null"
                    ],
                    "required": [
                        "form",
                        "show"
                    ],
                    "properties": {
                        "form": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/layoutNode"
                            }
                        },
                        "show": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/layoutNode"
                            }
                        }
                    },
                    "additionalProperties": false
                },
                "replicable": {
                    "description": "Whether a record may be duplicated into a new one's form; true unless the resource opts out (replicable()).",
                    "type": "boolean"
                },
                "globallySearchable": {
                    "description": "Whether GET /vector/search covers this resource.",
                    "type": "boolean"
                }
            },
            "not": {
                "anyOf": [
                    {
                        "required": [
                            "class"
                        ]
                    },
                    {
                        "required": [
                            "entity"
                        ]
                    },
                    {
                        "required": [
                            "columns"
                        ]
                    },
                    {
                        "required": [
                            "policy"
                        ]
                    },
                    {
                        "required": [
                            "entityProperties"
                        ]
                    },
                    {
                        "required": [
                            "searchColumns"
                        ]
                    },
                    {
                        "required": [
                            "summaryPlan"
                        ]
                    },
                    {
                        "required": [
                            "connection"
                        ]
                    }
                ]
            }
        },
        "condition": {
            "type": "object",
            "required": [
                "field",
                "op",
                "value"
            ],
            "properties": {
                "field": {
                    "type": "string"
                },
                "op": {
                    "enum": [
                        "eq",
                        "ne",
                        "in",
                        "nin",
                        "null",
                        "nnull"
                    ]
                },
                "value": {}
            }
        },
        "layoutNode": {
            "description": "One node of a resource's layout: a section, a group of tabs, a tab, or a field placed by name. Every key is present; the ones a kind does not use are null or false.",
            "type": "object",
            "required": [
                "kind",
                "label",
                "description",
                "collapsible",
                "collapsed",
                "columns",
                "span",
                "name",
                "children"
            ],
            "properties": {
                "kind": {
                    "enum": [
                        "section",
                        "tabs",
                        "tab",
                        "field"
                    ]
                },
                "label": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "collapsible": {
                    "type": "boolean"
                },
                "collapsed": {
                    "type": "boolean"
                },
                "columns": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1,
                    "maximum": 4
                },
                "span": {
