{
    "name": "kinetis/vector",
    "description": "A schema-driven admin platform for Kinetis applications: a compiled resource registry, a REST admin API and MCP tools over kinetis/orm entities.",
    "keywords": [
        "kinetis",
        "admin",
        "admin-panel",
        "crud",
        "orm",
        "mcp"
    ],
    "homepage": "https://kinetis.dev/vector/docs/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "support": {
        "docs": "https://kinetis.dev/vector/docs/",
        "issues": "https://github.com/kinetis-dev/vector-dev/issues",
        "source": "https://github.com/kinetis-dev/vector-dev"
    },
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.0",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "kinetis/authorization": "^1.0.6",
        "kinetis/database-bridge": "^1.4.2",
        "kinetis/framework": "^1.24.1",
        "kinetis/mcp": "^1.8.2",
        "kinetis/mcp-protocol": "^1.1.1",
        "kinetis/migrations": "^1.4.2",
        "kinetis/orm": "^1.13.1",
        "kinetis/persistence": "^1.4.5",
        "kinetis/query-builder": "^1.8.2",
        "kinetis/queue": "^1.7.2",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "ueberdosis/tiptap-php": "^2.2.1"
    },
    "suggest": {
        "kinetis/storage": "Uploads for file and image fields (FILESYSTEM_DRIVER, or VECTOR_STORAGE_CONNECTION)",
        "openspout/openspout": "XLSX exports (MIT; needs ext-zip), written in the queue worker",
        "league/flysystem": "The filesystem contract those uploads are written through; kinetis/storage brings it"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Vector\\": "src/"
        }
    },
    "extra": {
        "kinetis": {
            "scan": "Kinetis\\Vector\\",
            "discovery": "Kinetis\\Vector\\Registry\\VectorRegistry",
            "bootstrap": "Kinetis\\Vector\\PackageBootstrap"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
