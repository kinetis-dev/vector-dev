{
    "name": "@kinetis/vector-ui",
    "version": "0.16.0",
    "description": "The Kinetis Vector admin UI, as a Nuxt layer on Vuetify.",
    "keywords": [
        "kinetis",
        "vector",
        "admin",
        "nuxt",
        "nuxt-layer",
        "vuetify"
    ],
    "homepage": "https://kinetis.dev/vector/docs/",
    "bugs": {
        "url": "https://github.com/kinetis-dev/vector-dev/issues"
    },
    "license": "MIT",
    "author": "Alon Noy",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kinetis-dev/vector-dev.git",
        "directory": "packages/vector-ui"
    },
    "type": "module",
    "main": "./nuxt.config.ts",
    "files": [
        "nuxt.config.ts",
        "app",
        "dist/static",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "prepare": "nuxt prepare",
        "prepack": "node ../../scripts/check-vector-ui-pack.mjs",
        "generate:hosted": "node ../../scripts/build-hosted-bundle.mjs",
        "typecheck": "nuxt prepare && vue-tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.2",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-php": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.13.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.44.0",
        "@lezer/highlight": "^1.2.5",
        "@mdi/font": "^7.4.47",
        "@pinia/nuxt": "^1.0.3",
        "@tiptap/core": "^3.35.0",
        "@tiptap/extension-image": "^3.35.0",
        "@tiptap/extension-link": "^3.35.0",
        "@tiptap/extension-mention": "^3.35.0",
        "@tiptap/extension-placeholder": "^3.35.0",
        "@tiptap/extension-table": "^3.35.0",
        "@tiptap/markdown": "^3.35.0",
        "@tiptap/pm": "^3.35.0",
        "@tiptap/starter-kit": "^3.35.0",
        "@tiptap/suggestion": "^3.35.0",
        "@tiptap/vue-3": "^3.35.0",
        "@vueuse/core": "^15.0.0",
        "@vueuse/nuxt": "^15.0.0",
        "dompurify": "^3.5.0",
        "markdown-it": "^15.0.3",
        "pinia": "^4.1.0",
        "vue-i18n": "^11.4.23"
    },
    "peerDependencies": {
        "nuxt": "^4.6.3",
        "vue": "^3.5.0",
        "vuetify": "^4.2.0",
        "vuetify-nuxt-module": "^1.0.0-rc.6"
    },
    "devDependencies": {
        "@nuxt/test-utils": "^4.4.0",
        "@types/node": "^26.6.6",
        "@vue/test-utils": "^2.6.0",
        "happy-dom": "^21.0.4",
        "nuxt": "^4.6.4",
        "sass-embedded": "^1.108.2",
        "typescript": "~6.0.3",
        "vitest": "^5.1.1",
        "vue": "^3.5.46",
        "vue-tsc": "^3.3.14",
        "vuetify": "^4.3.4",
        "vuetify-nuxt-module": "^1.0.0-rc.6"
    }
}
