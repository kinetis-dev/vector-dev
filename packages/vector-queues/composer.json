{
    "name": "kinetis/vector-queues",
    "description": "A queue dashboard for kinetis/vector: queue sizes, failed jobs to browse, retry, forget and prune, and queues to clear, over kinetis/queue and kinetis/queue-failed-jobs.",
    "keywords": [
        "kinetis",
        "vector",
        "queue",
        "failed-jobs",
        "dashboard"
    ],
    "homepage": "https://kinetis.dev/vector/docs/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "support": {
        "docs": "https://kinetis.dev/vector/docs/",
        "issues": "https://github.com/kinetis-dev/vector-dev/issues",
        "source": "https://github.com/kinetis-dev/vector-dev"
    },
    "require": {
        "php": "^8.4",
        "kinetis/database-bridge": "^1.4.2",
        "kinetis/framework": "^1.24.2",
        "kinetis/persistence": "^1.4.5",
        "kinetis/queue": "^1.9",
        "kinetis/queue-failed-jobs": "^1.1",
        "kinetis/vector": "^0.14 || dev-main",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Vector\\Queues\\": "src/"
        }
    },
    "extra": {
        "kinetis": {
            "scan": "Kinetis\\Vector\\Queues\\",
            "bootstrap": "Kinetis\\Vector\\Queues\\PackageBootstrap",
            "vector": {
                "extensions": [
                    "resources/ui/queues.js"
                ]
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
