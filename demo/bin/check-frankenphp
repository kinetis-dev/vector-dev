#!/bin/sh
# Proves the frankenphp service runs the application the way Kinetis's
# primary runtime should: the right worker script, the same PHP
# extensions as app (PHP-FPM), Zend extensions and OPcache included, requests served by persistent worker
# threads rather than classic mode, the native database drivers, and request isolation across many
# interleaved requests on the same threads. The details are in
# check-frankenphp.php, which runs in the app container against the
# frankenphp service. Needs a migrated, seeded stack (docs/demo.md).
#
#   bin/check-frankenphp [--rounds=N] [--concurrency=N] [--wrong-expectation]
#
# Exits nonzero when any check fails. Run it from anywhere.
set -eu
cd "$(dirname "$0")/.."

# php_server sends every request to public/index.php, so that is the
# script the worker must run. Any other worker script fails, never
# quietly: one that returns without calling frankenphp_handle_request()
# stops FrankenPHP from starting at all, and one that does call it leaves
# public/index.php on FrankenPHP's regular threads, where Kinetis still
# picks its FrankenPHP adapter (frankenphp_handle_request() exists) and
# every request fails with "called while not in worker mode" — a 500.
routed=/workspace/demo/backend/public/index.php
cause="likely cause: the worker script (docker/Caddyfile worker.file, FRANKENPHP_WORKER_FILE) is not $routed"

echo "Worker: frankenphp runs $routed in worker mode"
if [ -z "$(docker compose ps -q --status running frankenphp)" ]; then
    log=$(docker compose logs --no-log-prefix --tail 300 frankenphp 2>&1)
    error=$(printf '%s\n' "$log" | grep '"level":"error"' | grep -o '"msg":"[^"]*"' | tail -1 || true)
    # FrankenPHP 1.13.1 sometimes crashes (exit 139) before logging that
    # error; the restart warnings before it name the worker either way.
    failed=$(printf '%s\n' "$log" | grep '"worker script has failed on restart"' | grep -o '"worker":"[^"]*"' | tail -1 | cut -d'"' -f4 || true)
    echo "  FAIL  the frankenphp service is not running${error:+ — its last error: $error}"
    if [ -n "$failed" ]; then
        echo "        $cause: $failed returned without ever calling frankenphp_handle_request(), on every thread, until FrankenPHP stopped"
    else
        echo "        start it with \`docker compose up -d frankenphp\` and read \`docker compose logs frankenphp\`"
    fi
    echo
    echo "FAIL"
    exit 1
fi

# the configuration Caddy runs, its env placeholders resolved
adapted=$(docker compose exec -T frankenphp frankenphp adapt --config /etc/frankenphp/Caddyfile 2>/dev/null)
worker=$(printf '%s' "$adapted" | sed -n 's/.*"workers":\[{"file_name":"\([^"]*\)".*/\1/p')
threads=$(printf '%s' "$adapted" | sed -n 's/.*"workers":\[{[^}]*"num":\([0-9]*\).*/\1/p')
if [ "$worker" = "$routed" ]; then
    echo "  ok    ${threads:-?} worker threads on $worker"
    workers=0
else
    echo "  FAIL  the worker runs ${worker:-(none)}, but php_server routes every request to $routed"
    echo "        $cause: requests run outside worker mode and fail with a 500"
    workers=1
fi

# The PHP version, then every loaded extension and the version of each
# one PECL installs (a bundled one reports PHP's own version), then every
# Zend extension (OPcache, a debugger) with its version: plain
# get_loaded_extensions() leaves those out. The Dockerfile pins the PHP
# minor for both bases, not the patch each base image ships, so a patch
# drift between them fails here too.
inventory='echo "PHP ", PHP_VERSION, "\n"; foreach ([false, true] as $zend) { $e = get_loaded_extensions($zend); sort($e); foreach ($e as $x) { $v = phpversion($x); echo $zend ? "zend " : "", $x, $v === PHP_VERSION ? "" : " $v", "\n"; } }'

echo "Extensions: app (PHP-FPM) and frankenphp load the same set, Zend extensions included"
app=$(docker compose exec -T app php -r "$inventory")
frankenphp=$(docker compose exec -T frankenphp php -r "$inventory")
if [ "$app" = "$frankenphp" ]; then
    echo "  ok    $(printf '%s\n' "$app" | head -1), $(printf '%s\n' "$app" | tail -n +2 | grep -vc '^zend ') extensions and $(printf '%s\n' "$app" | grep -c '^zend ') Zend extension(s) ($(printf '%s\n' "$app" | sed -n 's/^zend //p' | paste -sd, -)), identical, versions included"
    extensions=0
else
    echo "  FAIL  the two images differ:"
    printf '%s\n' "$app" > "${TMPDIR:-/tmp}/check-frankenphp-app.txt"
    printf '%s\n' "$frankenphp" > "${TMPDIR:-/tmp}/check-frankenphp-frankenphp.txt"
    diff "${TMPDIR:-/tmp}/check-frankenphp-app.txt" "${TMPDIR:-/tmp}/check-frankenphp-frankenphp.txt" | sed 's/^/        /' || true
    extensions=1
fi

# OPcache as each web SAPI runs it (the CLI has its own opcache.enable_cli):
# GET /_demo/runtime reports opcache_get_status() from PHP-FPM behind nginx
# and from a FrankenPHP worker.
opcache_of() {
    docker compose exec -T app php -r '$d = json_decode((string) @file_get_contents($argv[1]), true); echo is_array($d) && is_bool($d["opcache"] ?? null) ? ($d["opcache"] ? "enabled" : "disabled") : "unknown";' "$1"
}
echo "OPcache: PHP-FPM and the FrankenPHP worker run with the same setting"
fpm_opcache=$(opcache_of http://nginx:8080/_demo/runtime)
worker_opcache=$(opcache_of http://frankenphp:8081/_demo/runtime)
if [ "$fpm_opcache" = "$worker_opcache" ] && [ "$fpm_opcache" != unknown ]; then
    echo "  ok    $fpm_opcache under both"
    opcache=0
else
    echo "  FAIL  PHP-FPM: $fpm_opcache, FrankenPHP worker: $worker_opcache"
    opcache=1
fi

status=0
docker compose exec -T app php /workspace/demo/bin/check-frankenphp.php --threads="${threads:-12}" "$@" || status=$?

if [ "$status" -ne 0 ] && docker compose logs --no-log-prefix --since 5m frankenphp 2>&1 | grep -q 'called while not in worker mode'; then
    echo "frankenphp's log: \"frankenphp_handle_request() called while not in worker mode\" — $cause"
fi

if [ "$workers" -ne 0 ] || [ "$extensions" -ne 0 ] || [ "$opcache" -ne 0 ]; then
    # check-frankenphp.php's own verdict above covers only (a) to (c)
    echo "FAIL: the worker, extension or OPcache check above failed"
    exit 1
fi
exit "$status"
