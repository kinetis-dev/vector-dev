{
    "name": "kinetis/vector-demo",
    "description": "The Vector demo: a Kinetis application with a shop on MySQL and a support desk on PostgreSQL, administered by kinetis/vector.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mysqli": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_pgsql": "*",
        "ext-pgsql": "*",
        "kinetis/auth-jwt": "^1.5.2",
        "kinetis/authorization": "^1.0.6",
        "kinetis/cache-redis": "^1.3.2",
        "kinetis/database-bridge": "^1.4.2",
        "kinetis/framework": "^1.24.1",
        "kinetis/mcp": "^1.8.2",
        "kinetis/migrations": "^1.4.2",
        "kinetis/orm": "^1.13.1",
        "kinetis/query-builder": "^1.8.2",
        "kinetis/queue": "^1.7.2",
        "kinetis/queue-redis": "^1.8.3",
        "kinetis/queue-sql": "^1.6.6",
        "kinetis/session": "^1.3.3",
        "kinetis/storage": "^1.2.6",
        "kinetis/vector": "dev-main",
        "openspout/openspout": "^5.13",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.8",
        "kinetis/mcp-docs": "^1.9.1",
        "kinetis/mcp-protocol": "^1.1.1",
        "kinetis/orbitron": "^1.11.4",
        "opis/json-schema": "^2.6.0",
        "phpstan/phpstan": "^2.3.4",
        "phpunit/phpunit": "^13.4.5",
        "vimeo/psalm": "^6.20.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "psalm": "psalm --no-progress",
        "psalm:taint": "@php -d zend.assertions=-1 vendor/bin/psalm --taint-analysis --no-progress --report=psalm.sarif --report-show-info=false",
        "infection": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=1G vendor/bin/infection --threads=1 --only-covering-test-cases --no-progress"
        ],
        "infection:vector": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=1G vendor/bin/infection --configuration=infection.vector.json5 --threads=4 --no-progress"
        ],
        "infection:workers": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/provision-test-workers 4"
        ]
    },
    "scripts-descriptions": {
        "psalm": "Psalm over the demo, packages/vector/src and the migrations",
        "psalm:taint": "Psalm taint analysis over the same trees; writes psalm.sarif",
        "infection": "Mutation testing over the demo's src/, gated on its measured MSI; on worker 1's stores",
        "infection:vector": "Mutation testing over Vector's Registry and Query on four workers; run infection:workers first",
        "infection:workers": "Recreates, migrates and seeds the databases of mutation-testing workers 1 to 4 (tests/worker-stores.php)"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "vector",
            "type": "path",
            "url": "../../packages/vector",
            "options": {
                "versions": {
                    "kinetis/vector": "dev-main"
                }
            }
        }
    ]
}
