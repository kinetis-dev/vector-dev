{
    "name": "kinetis/skeleton",
    "description": "The smallest possible runnable Kinetis application: nginx + PHP-FPM, one controller, one route, a welcome page.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mysqli": "*",
        "ext-pdo_mysql": "*",
        "kinetis/auth-jwt": "^1.5.0",
        "kinetis/authorization": "^1.0.4",
        "kinetis/database-bridge": "^1.4.0",
        "kinetis/framework": "^1.21.1",
        "kinetis/mcp": "^1.8.0",
        "kinetis/migrations": "^1.4.0",
        "kinetis/orm": "^1.12.0",
        "kinetis/query-builder": "^1.8.0",
        "kinetis/queue": "^1.7.0",
        "kinetis/queue-redis": "^1.8.1",
        "kinetis/queue-sql": "^1.6.3",
        "kinetis/session": "^1.3.1",
        "kinetis/storage": "^1.2.3",
        "kinetis/vector": "@dev",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.4",
        "kinetis/mcp-docs": "^1.8.0",
        "kinetis/mcp-protocol": "^1.1.0",
        "kinetis/orbitron": "^1.11.1",
        "opis/json-schema": "^2.6.0",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^13.3.5",
        "vimeo/psalm": "^6.18.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "vector",
            "type": "path",
            "url": "../../packages/vector"
        }
    ]
}
