includes:
    - vendor/kinetis/orm/extension.neon

parameters:
    level: 8
    paths:
        - src
        - ../../packages/vector/src
        - ../../packages/vector-queues/src
        - migrations
        - bootstrap.php
        - public/index.php
        - tests
    ignoreErrors:
        # Liveness-test setup and its lock holder, outside the observed operation.
        -
            identifier: kinetis.blockingCall
            paths:
                - tests/Vector/LoopLivenessTest.php
                - tests/Fixtures/hold-products-lock.php
        # The test bootstrap owns its process: it gives each parallel worker its
        # own stores through the environment, $_SERVER included, before boot.
        -
            identifier: kinetis.superglobal
            path: tests/bootstrap.php

services:
    -
        class: Kinetis\Linting\NoStaticPropertiesRule
        tags:
            - phpstan.rules.rule
    -
        class: Kinetis\Linting\NoBlockingIoRule
        tags:
            - phpstan.rules.rule
    -
        class: Kinetis\Linting\NoProcessGlobalsRule
        tags:
            - phpstan.rules.rule
