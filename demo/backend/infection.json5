{
    // Mutation testing over the demo's own src/, the whole suite against
    // seeded databases (docs/contributing.md):
    //   docker compose exec app composer infection
    // One thread. The base databases serve only the initial run: each
    // mutant runs on worker 1's own stores (tests/worker-stores.php,
    // keyed on Infection's TEST_TOKEN), so run `composer infection:workers`
    // before each run: a killed mutant can leave the rows its test would
    // have removed, and it starts them over. More threads would not be
    // isolated: VectorRedisQueueTest, for one, names its own Redis database,
    // which every worker would share.
    //
    // Measured 2026-10-06 (--threads=1 --only-covering-test-cases):
    // 665 mutants, 500 killed, 165 escaped, 0 skipped — MSI 75.19%,
    // covered MSI 75.19% (mutation coverage 100%). The same mutants run
    // with whole covering test classes killed 5 more, so the floors sit
    // two points under the measurement.
    //
    // The timeout is above the full suite's ~75 s: nearly every test
    // signs in, so the login code's covering tests add up to more than
    // the default 10 s, and Infection skips (does not score) a mutant
    // whose covering tests exceed it.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 120,
    "logs": { "text": "infection.log", "summary": "infection.summary.log" },
    "minMsi": 73,
    "minCoveredMsi": 73,
    "mutators": {
        "@default": true
    }
}
