APP_ENV=development

# Serve /openapi.json and /openapi here. Unset, they are served nowhere.
OPENAPI_ENVIRONMENTS=development

# The demo database. docker-compose.yml starts MySQL 8.4 with these
# values; DB_HOST is the Compose service name.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=vector
DB_USER=vector
DB_PASSWORD=vector

# Signs and verifies the admin's access tokens. At least 32 bytes:
# php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
JWT_SECRET=

# The origin the admin UI is served from in standalone mode, allowed by CORS.
VECTOR_UI_ORIGIN=http://localhost:3000

# Hosted mode: the admin served by this application at /vector/ui with the
# session cookie. SESSION_SECURE=false is for plain-HTTP development only.
SESSION_DRIVER=file
SESSION_SECURE=false
VECTOR_LOGIN_URL=/login
VECTOR_LOGOUT_URL=/logout

# Hosted-mode shell: a raw fragment appended before </head> ({nonce} is
# replaced by the response's script nonce). Deployment configuration — the
# only way script reaches the admin's head.
VECTOR_SHELL_HEAD=

# One Content-Security-Policy for the whole application, sent by the
# framework's security headers with {nonce} replaced per request. The
# hosted shell and the sign-in page put that request's nonce on their
# inline tags. VECTOR_SHELL_CSP would give the shell a policy of its own.
SECURITY_CSP="default-src 'self'; script-src 'self' 'nonce-{nonce}'; style-src 'self' 'nonce-{nonce}'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

# Background jobs (queued actions, large exports, imports) on Redis: the
# `redis` service in docker-compose.yml, on the named queue connection
# "jobs" — its backend is QUEUE_JOBS_CONNECTION and its server REDIS_JOBS_*,
# apart from the application's cache (REDIS_HOST, below). The `worker`
# service runs `kinetis queue:work`. QUEUE_MAX_ATTEMPTS=1 gives up on an
# application job that fails once; Vector's own jobs are pushed for one
# attempt whatever this says, since each writes its failure to its row.
QUEUE_CONNECTION_NAME=jobs
QUEUE_JOBS_CONNECTION=redis
REDIS_JOBS_HOST=redis
REDIS_JOBS_PORT=6379
QUEUE_MAX_ATTEMPTS=1

# The application's cache (kinetis/cache-redis), on the same Redis server in
# its own database: login throttling and refresh tokens are stored there.
# Without it, /auth/login and the sign-in form answer 503 rather than
# signing anyone in unthrottled.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_CACHE_NAMESPACE=demo

# Runtime UI extensions: ES modules the admin imports after boot,
# same-origin or CORS-enabled. Script authority stays with the deployer.
# The currency a Currency field without a default of its own starts from.
VECTOR_CURRENCY=EUR
VECTOR_UI_EXTENSIONS=/vector-extensions/stock-level.js,/vector-extensions/stock-overview.js
# The demo's labels in German, French, Dutch, Italian, Spanish, Portuguese and Hebrew (machine translations).
VECTOR_TRANSLATIONS_DIR=translations

# Vector's own tables (views, jobs, audit, settings, …) on a named
# connection: PostgreSQL in the demo, next to the MySQL domain. Created
# by `kinetis vector:install --connection=admin` + `kinetis migrate`.
# Unset VECTOR_DB_CONNECTION to keep them on the default connection.
DB_ADMIN_CONNECTION=pgsql
DB_ADMIN_HOST=postgres
DB_ADMIN_PORT=5432
DB_ADMIN_NAME=vector_admin
DB_ADMIN_USER=vector
DB_ADMIN_PASSWORD=vector
VECTOR_DB_CONNECTION=admin

# The support-desk domain (App\Domain\Support), on its own PostgreSQL
# database: entities declare #[Entity(connection: 'support')], and its
# migrations live in migrations/support/.
DB_SUPPORT_CONNECTION=pgsql
DB_SUPPORT_HOST=postgres
DB_SUPPORT_PORT=5432
DB_SUPPORT_NAME=vector_support
DB_SUPPORT_USER=vector
DB_SUPPORT_PASSWORD=vector

# Vector's background jobs use the application's queue above (Redis),
# under a queue name of their own; the application's worker serves both
# names (queue:work --queue=default,vector). VECTOR_QUEUE_CONNECTION
# could put them on a named queue connection of their own instead, served
# by a worker of its own (queue:work --connection=<name> --queue=vector).
VECTOR_QUEUE=vector

# Request bodies up to 12 MB: a 10 MB file or a CSV import plus the
# multipart framing. nginx's client_max_body_size must be at least this.
MAX_BODY_SIZE=12000000

# Uploaded files: local disk on a private volume the app and worker share
# (see docker-compose.yml). Vector's file and image fields store here.
FILESYSTEM_DRIVER=local
FILESYSTEM_ROOT=/var/lib/vector-storage
