{
    "name": "vector-monorepo",
    "private": true,
    "packageManager": "pnpm@10.17.1",
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "scripts": {
        "dev": "pnpm --filter frontend dev",
        "build": "pnpm --filter frontend build",
        "generate": "pnpm --filter frontend generate",
        "generate:hosted": "node scripts/build-hosted-bundle.mjs",
        "typecheck": "pnpm --filter @kinetis/vector-ui typecheck",
        "lint": "eslint .",
        "test": "pnpm --filter @kinetis/vector-ui test",
        "test:scripts": "node --test 'scripts/*.test.mjs'"
    },
    "devDependencies": {
        "@nuxt/eslint-config": "^1.17.0",
        "eslint": "^10.13.0",
        "typescript": "~6.0.3"
    }
}
